# Supabase productie-project (anon key mag in bundle, service_role NOOIT)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Admin email — frontend whitelist + RLS-policy expecteert dit account als is_admin = true
VITE_ADMIN_EMAIL=admin@noordhoff.nl

# Microsoft Entra ID SSO — placeholder; pas op true als Infinitas IT de OAuth-provider in Supabase heeft geconfigureerd
VITE_ADMIN_SSO_ENABLED=false

# Lokale scripts (seed, bulk-upload) — service_role key mag uitsluitend lokaal staan, NIET in CI
# SUPABASE_SERVICE_ROLE_KEY=

# Edge Function secret (test-fase): zet `DISABLE_AUTH_EMAILS=true` in Supabase
# secrets om alle invite/recovery-mails af te schakelen. Productie-activatie:
#   supabase secrets set DISABLE_AUTH_EMAILS=true
# DISABLE_AUTH_EMAILS=true

# Frontend test-fase-vlag: zet op `true` om 2FA (TOTP-challenge bij login +
# verplichte enrollment na eerste login) volledig over te slaan. Bestaande
# factors in auth.mfa_factors blijven staan; bij weghalen van deze vlag treedt
# enforcement automatisch weer in werking.
# VITE_DISABLE_MFA=true
