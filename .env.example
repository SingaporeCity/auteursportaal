# Supabase productie-project (anon key mag in bundle, service_role NOOIT)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Admin email — frontend whitelist + RLS-policy expecteert dit account als is_admin = true
VITE_ADMIN_EMAIL=admin@noordhoff.nl

# Microsoft Entra ID SSO — placeholder; pas op true als Infinitas IT de OAuth-provider in Supabase heeft geconfigureerd
VITE_ADMIN_SSO_ENABLED=false

# Lokale scripts (seed, bulk-upload) — service_role key mag uitsluitend lokaal staan, NIET in CI
# SUPABASE_SERVICE_ROLE_KEY=
